// FunnelCore Prisma schema.
// See docs/funnelcore/DATA_MODEL.md for the authoritative, prose description of this schema.
// If the two ever disagree, THIS file is the source of truth for the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Status {
  ACTIVE
  ARCHIVED
}

enum LinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PathType {
  DIRECT
  AGGREGATOR
  TELEGRAM
}

// Matches the public funnel route's vocabulary exactly (see
// src/lib/public-routing.ts) — every step the public route can take writes
// one of these, so the funnel can be reconstructed from FunnelEvent alone.
enum FunnelStepType {
  ROUTE_RESOLVED
  AGE_GATE_SHOWN
  AGE_GATE_ACCEPTED
  AGE_GATE_DECLINED
  AGGREGATOR_VIEWED
  AGGREGATOR_CONTINUE_CLICKED
  TELEGRAM_REDIRECTED
  TELEGRAM_STARTED
  OUTBOUND_PAYBIG_REDIRECTED
  ROUTE_FAILED
}

enum ConversionStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum AdminRole {
  ADMIN
  VIEWER
}

enum ApiConnectionAuthType {
  NONE
  API_KEY_HEADER
  API_KEY_QUERY
  BEARER_TOKEN
  BASIC_AUTH
}

// ---------------------------------------------------------------------------
// Admin / audit
// ---------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs        AuditLog[]
  publishedVersions TrackingLinkVersion[]
  sessions          Session[]

  @@map("admin_users")
}

// Server-side session record backing the admin's HTTP-only session cookie.
// The cookie carries only an opaque random token; tokenHash is the only copy
// stored, so a database read alone can never yield a usable session token —
// the same principle applied to password/credential storage elsewhere here.
model Session {
  id            String    @id @default(cuid())
  adminUserId   String
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id])
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([adminUserId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Configuration entities (admin-managed, never hardcoded)
// ---------------------------------------------------------------------------

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccounts SocialAccount[]
  domains        Domain[]
  campaigns      Campaign[]
  telegramBots   TelegramBot[]
  apiConnections ApiConnection[]
  experiments    Experiment[]
  trackingLinks  TrackingLink[]
  clicks         Click[]
  conversions    Conversion[]

  @@map("brands")
}

model Platform {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccounts SocialAccount[]
  clicks         Click[]
  campaigns      Campaign[]

  @@map("platforms")
}

model SocialAccount {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  platformId  String
  platform    Platform @relation(fields: [platformId], references: [id])
  handle      String
  displayName String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trackingLinkVersions TrackingLinkVersion[]
  clicks               Click[]

  @@unique([brandId, platformId, handle])
  @@map("social_accounts")
}

model Domain {
  id        String   @id @default(cuid())
  hostname  String   @unique
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingLinks TrackingLink[]

  @@map("domains")
}

model Campaign {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id])
  name       String
  slug       String
  paybigUrl  String
  // At most one ACTIVE default per (brandId, platformId), enforced at the
  // application layer (see lib/campaigns.ts) — not a DB constraint, same
  // tradeoff as the pathConfig/telegramBotId consistency rule (D005/OPEN_QUESTIONS).
  isDefault  Boolean  @default(false)
  status     Status   @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trackingLinkVersions TrackingLinkVersion[]
  clicks               Click[]
  conversions          Conversion[]

  @@unique([brandId, slug])
  @@map("campaigns")
}

model TelegramBot {
  id                 String   @id @default(cuid())
  brandId            String
  brand              Brand    @relation(fields: [brandId], references: [id])
  name               String
  // Set by the "Validate" admin action's live getMe call — null means the
  // token has never been successfully validated against Telegram's API.
  botUsername        String?
  botTokenCiphertext String
  // Our own shared secret, given to Telegram via setWebhook so inbound
  // webhook calls can be checked against the X-Telegram-Bot-Api-Secret-Token
  // header. Encrypted at rest like the bot token; null until a validate call
  // successfully registers a webhook. Never logged or exposed to the client.
  webhookSecretCiphertext String?
  welcomeMessage     String?
  ctaLabel           String?
  status             Status   @default(ACTIVE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trackingLinkVersions TrackingLinkVersion[]
  startPayloads        TelegramStartPayload[]

  @@map("telegram_bots")
}

// An opaque token embedded in a `t.me/<bot>?start=<token>` deep link so a
// Telegram bot start event can be traced back to the Click that produced it.
// Short-lived by design (expiresAt) — resolved almost immediately after
// creation, so unlike TrackingLinkVersion/Click it does not need its own
// frozen denormalized copies; resolution joins through Click at lookup time.
model TelegramStartPayload {
  id            String    @id @default(cuid())
  clickId       String
  click         Click     @relation(fields: [clickId], references: [id])
  telegramBotId String
  telegramBot   TelegramBot @relation(fields: [telegramBotId], references: [id])
  payloadToken  String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?

  @@index([clickId])
  @@map("telegram_start_payloads")
}

model ApiConnection {
  id                    String   @id @default(cuid())
  brandId               String?
  brand                 Brand?   @relation(fields: [brandId], references: [id])
  name                  String
  provider              String
  baseUrl               String
  authType              ApiConnectionAuthType @default(NONE)
  credentialsCiphertext String
  status                Status   @default(ACTIVE)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("api_connections")
}

model Experiment {
  id             String    @id @default(cuid())
  brandId        String
  brand          Brand     @relation(fields: [brandId], references: [id])
  trackingLinkId String?
  trackingLink   TrackingLink? @relation(fields: [trackingLinkId], references: [id])
  name           String
  variantConfig  Json?
  status         Status    @default(ACTIVE)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  arms ExperimentArm[]

  @@map("experiments")
}

// A single variant within an Experiment. Kept as its own table (rather than
// folded into Experiment.variantConfig) because arms are queried/joined
// directly once traffic-split execution is built in a later phase.
model ExperimentArm {
  id                    String    @id @default(cuid())
  experimentId          String
  experiment            Experiment @relation(fields: [experimentId], references: [id])
  name                  String
  trackingLinkVersionId String?
  trackingLinkVersion   TrackingLinkVersion? @relation(fields: [trackingLinkVersionId], references: [id])
  weight                Int
  status                Status    @default(ACTIVE)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([experimentId, name])
  @@map("experiment_arms")
}

// ---------------------------------------------------------------------------
// TrackingLink / TrackingLinkVersion — the executable public route object
// ---------------------------------------------------------------------------

model TrackingLink {
  id                String   @id @default(cuid())
  label             String
  // Token is the routing key within a domain, not globally — see DECISIONS.md D015.
  token             String
  brandId           String
  brand             Brand    @relation(fields: [brandId], references: [id])
  domainId          String
  domain            Domain   @relation(fields: [domainId], references: [id])
  currentVersionId  String?  @unique
  currentVersion    TrackingLinkVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  status            LinkStatus @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions    TrackingLinkVersion[] @relation("VersionsOfLink")
  clicks      Click[]
  experiments Experiment[]

  @@unique([domainId, token])
  @@map("tracking_links")
}

// Immutable once created. Never updated after publish — see ARCHITECTURE.md §5.
model TrackingLinkVersion {
  id               String   @id @default(cuid())
  trackingLinkId   String
  trackingLink     TrackingLink @relation("VersionsOfLink", fields: [trackingLinkId], references: [id])
  versionNumber    Int
  pathType         PathType
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  socialAccountId  String?
  socialAccount    SocialAccount? @relation(fields: [socialAccountId], references: [id])
  telegramBotId    String?
  telegramBot      TelegramBot? @relation(fields: [telegramBotId], references: [id])
  ageGateEnabled   Boolean  @default(false)
  pathConfig       Json
  // Denormalized copy of everything routing needs at click time — domain,
  // token, brand, platform, campaign (incl. Paybig destination), social
  // account, path type/config, age gate, experiment/arm context. Frozen at
  // publish time so a later edit to any of those mutable rows (e.g. a
  // campaign's Paybig URL) can never retroactively change this version's
  // behavior. Never contains secrets — see DECISIONS.md D016.
  snapshot         Json
  publishedAt      DateTime @default(now())
  publishedById    String
  publishedBy      AdminUser @relation(fields: [publishedById], references: [id])

  currentForLink TrackingLink? @relation("CurrentVersion")
  clicks         Click[]
  experimentArms ExperimentArm[]

  @@unique([trackingLinkId, versionNumber])
  @@map("tracking_link_versions")
}

// ---------------------------------------------------------------------------
// Attribution / funnel data
// ---------------------------------------------------------------------------

// Authoritative click record. Attribution fields are copied from the resolved
// version at click time — never re-derived by joining live/mutable rows.
model Click {
  id                     String   @id @default(cuid())
  trackingLinkId         String
  trackingLink           TrackingLink @relation(fields: [trackingLinkId], references: [id])
  trackingLinkVersionId  String
  trackingLinkVersion    TrackingLinkVersion @relation(fields: [trackingLinkVersionId], references: [id])
  brandId                String
  brand                  Brand    @relation(fields: [brandId], references: [id])
  platformId             String?
  platform               Platform? @relation(fields: [platformId], references: [id])
  socialAccountId        String?
  socialAccount          SocialAccount? @relation(fields: [socialAccountId], references: [id])
  campaignId             String?
  campaign               Campaign? @relation(fields: [campaignId], references: [id])
  ipHash                 String?
  userAgent              String?
  referrer               String?
  utmParams              Json?
  countryCode            String?
  deviceType             String?
  clickedAt              DateTime @default(now())

  funnelEvents          FunnelEvent[]
  conversions           Conversion[]
  telegramStartPayloads TelegramStartPayload[]

  @@index([trackingLinkId, clickedAt])
  @@index([campaignId])
  @@map("clicks")
}

model FunnelEvent {
  id         String   @id @default(cuid())
  clickId    String
  click      Click    @relation(fields: [clickId], references: [id])
  stepType   FunnelStepType
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([clickId, occurredAt])
  @@map("funnel_events")
}

// Paybig is authoritative for signups. This table records what Paybig told us
// and how it was attributed — it does not recompute or override Paybig's data.
model Conversion {
  id                  String   @id @default(cuid())
  paybigConversionId  String   @unique
  clickId             String?
  click               Click?   @relation(fields: [clickId], references: [id])
  campaignId          String?
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  brandId             String?
  brand               Brand?   @relation(fields: [brandId], references: [id])
  amount              Decimal? @db.Decimal(12, 2)
  currency            String?
  status              ConversionStatus @default(PENDING)
  occurredAt          DateTime
  receivedAt          DateTime @default(now())
  rawPayload          Json

  @@index([clickId])
  @@index([campaignId])
  @@map("conversions")
}
