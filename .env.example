# Copy this file to .env and fill in real local values.
# Never commit .env or any file containing real secrets.

# --- Database -----------------------------------------------------------
#
# DATABASE_URL: the connection string the RUNNING APPLICATION uses for every
# query (Prisma Client, instantiated in src/lib/prisma.ts). In production
# (e.g. Vercel) this MUST be a pooled connection string (PgBouncer, or your
# provider's built-in pooler — Neon and Supabase both expose one) because a
# serverless deployment opens far more concurrent short-lived connections
# than a traditional long-lived server would; pointing this at an
# unpooled/direct connection in production risks exhausting Postgres's
# connection limit under real traffic. Locally, against the single Postgres
# instance from docker-compose.yml, there is no pooler — DATABASE_URL and
# DIRECT_DATABASE_URL are simply the same value.
DATABASE_URL="postgresql://funnelcore:funnelcore@localhost:5432/funnelcore?schema=public"
#
# DIRECT_DATABASE_URL: a connection string that talks to Postgres directly,
# bypassing any pooler. Used ONLY by the Prisma CLI (`prisma migrate deploy`,
# `prisma migrate dev`, `prisma studio`, etc. — see the `directUrl` field in
# prisma/schema.prisma) — migrations need a direct connection because pooled
# connections (transaction-mode PgBouncer in particular) don't support the
# session-level features migrations rely on. The running application never
# reads this variable. In production, your database provider gives you both
# a pooled and an unpooled connection string — DATABASE_URL gets the pooled
# one, this gets the unpooled one. Locally, set it to the exact same value
# as DATABASE_URL above.
DIRECT_DATABASE_URL="postgresql://funnelcore:funnelcore@localhost:5432/funnelcore?schema=public"

# --- Secrets --------------------------------------------------------------
#
# Field-level encryption key for Telegram bot tokens and API connection credentials
# (AES-256-GCM). Generate a random 32-byte value, e.g.: openssl rand -base64 32
# Never reuse this value across environments — a production deployment needs its
# own freshly generated key, not the local dev value. Validated at startup
# (src/instrumentation.ts): the app refuses to boot if this is missing or does
# not decode to exactly 32 bytes.
ENCRYPTION_KEY="replace-with-a-random-32-byte-value"

# --- App configuration ------------------------------------------------------
#
# The real public base URL the app is served from — used to build absolute
# links (Telegram deep links) and to register the Telegram webhook URL. In
# production this MUST be the real public HTTPS origin (e.g.
# "https://yourdomain.com"); Telegram's `setWebhook` cannot reach
# "http://localhost:3000" or a non-public URL. Not enforced at startup as a
# hard failure (a warning only), since local dev has a working fallback.
APP_BASE_URL="http://localhost:3000"

# --- First admin account (bootstrap only) -----------------------------------
#
# Read only by `npm run prisma:seed` (prisma/seed.ts) to create or update the
# first AdminUser row via an upsert — never read by the running application
# itself, and safe to re-run. There is no other way to create the first admin
# account (no public registration route). SEED_ADMIN_PASSWORD must be at
# least 8 characters. Change the password by logging in and re-seeding (or
# via a future admin-user-management UI) after first login in any real
# deployment — do not leave the bootstrap password in place.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-local-password"

# Paybig integration credentials — placeholders only. See docs/funnelcore/OPEN_QUESTIONS.md
# for the unresolved integration contract; fill these in once that's settled.
PAYBIG_API_BASE_URL=""
PAYBIG_API_KEY=""
PAYBIG_WEBHOOK_SECRET=""
