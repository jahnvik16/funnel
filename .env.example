# Copy this file to .env and fill in real local values.
# Never commit .env or any file containing real secrets.

# Postgres connection string used by Prisma. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://funnelcore:funnelcore@localhost:5432/funnelcore?schema=public"

# Field-level encryption key for Telegram bot tokens and API connection credentials
# (AES-256-GCM). Generate a random 32-byte value, e.g.: openssl rand -base64 32
# Never reuse this value across environments.
ENCRYPTION_KEY="replace-with-a-random-32-byte-value"

# Base URL the app is served from (used to build absolute links, e.g. Telegram deep links).
APP_BASE_URL="http://localhost:3000"

# Used only by `npm run prisma:seed` to create the first admin account. Not read by the
# running application. Change the password after first login; this is a bootstrap value.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-local-password"

# Paybig integration credentials — placeholders only. See docs/funnelcore/OPEN_QUESTIONS.md
# for the unresolved integration contract; fill these in once that's settled.
PAYBIG_API_BASE_URL=""
PAYBIG_API_KEY=""
PAYBIG_WEBHOOK_SECRET=""
